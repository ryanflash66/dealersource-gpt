# Supabase REST URL for deployed durable storage; unset uses local fixture storage.
SUPABASE_URL=
# Server-only service role key; never expose to dashboard.
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase URL for deployed dashboard; unset builds fixture dashboard.
PUBLIC_SUPABASE_URL=
# Public anon key; RLS still requires an authorized user JWT.
PUBLIC_SUPABASE_ANON_KEY=
# Optional local Postgres/PostGIS connection for migration smoke tests.
DATABASE_URL=
# Selected Census geocoder endpoint; unset selects recorded fixtures.
CENSUS_GEOCODER_URL=
# Self-hosted Nominatim endpoint only; public Nominatim is rejected.
NOMINATIM_URL=
# NC OneMap parcel layer query endpoint.
PARCELS_URL=
# County parcel fallback query endpoint.
COUNTY_PARCELS_URL=
# Parcel ID attribute name.
PARCEL_ID_FIELD=
# Parcel acreage attribute name.
PARCEL_ACRES_FIELD=
# Official zoning layer query endpoint.
ZONING_URL=
# Official zoning district attribute name.
ZONING_DISTRICT_FIELD=
# Exact official use-table URL; absence keeps zoning pending.
ZONING_USE_TABLE_URL=
# Published planning department inquiry email.
PLANNING_EMAIL=
# Official government page publishing the planning email.
PLANNING_CONTACT_SOURCE=
# Self-hosted OSRM base URL for driving routes.
OSRM_URL=
# Self-hosted Valhalla route endpoint.
VALHALLA_URL=
# OpenRouteService isochrone endpoint.
ORS_URL=
# OpenRouteService key, subject to approved tier and quota.
ORS_API_KEY=
# NCDOT AADT ArcGIS query endpoint.
NCDOT_AADT_URL=
# AADT attribute name.
AADT_FIELD=
# Fronting road ID attribute name.
ROAD_ID_FIELD=
# FEMA NFHL query endpoint.
FEMA_NFHL_URL=
# Official NC orthoimagery metadata endpoint.
ORTHOIMAGERY_URL=
# Mapillary image search endpoint.
MAPILLARY_URL=
# Mapillary token.
MAPILLARY_TOKEN=
# Polite or self-hosted Overpass endpoint.
OVERPASS_URL=
# Self-hosted PMTiles archive URL.
PMTILES_URL=
# Self-hosted MapLibre ES module URL for live basemap.
MAPLIBRE_SCRIPT_URL=
# Self-hosted PMTiles protocol ES module URL.
PMTILES_SCRIPT_URL=
# Self-hosted MapLibre style JSON URL.
MAP_STYLE_URL=
# Required attribution for deployed map data.
MAP_ATTRIBUTION=
# Self-hosted AnyCrawl scrape endpoint.
ANYCRAWL_URL=
# Optional paid AnyCrawl cloud endpoint, gated by providers.yaml.
ANYCRAWL_CLOUD_URL=
# Optional paid AnyCrawl key.
ANYCRAWL_API_KEY=
# Official Reddit OAuth API base URL.
REDDIT_API_URL=
# Reddit access token for an approved use case.
REDDIT_ACCESS_TOKEN=
# Configurable OAuth owner mailbox address.
GMAIL_OWNER_ADDRESS=
# Explicitly selected operator fallback mailbox address.
GMAIL_OPERATOR_ADDRESS=
# Optional short-lived Gmail access token.
GMAIL_ACCESS_TOKEN=
# OAuth refresh token authorized once at deployment.
GMAIL_REFRESH_TOKEN=
# Gmail OAuth client ID.
GMAIL_CLIENT_ID=
# Gmail OAuth client secret.
GMAIL_CLIENT_SECRET=
# Local JSON output file written by the scheduled Claude agent.
AGENT_RESPONSES_PATH=
# Optional paid Claude API key, gated by providers.yaml.
ANTHROPIC_API_KEY=
# Approved Claude API model ID if paid API is selected.
CLAUDE_MODEL=
# Optional paid Google geocoding endpoint.
GOOGLE_GEOCODING_URL=
# Optional paid Google driving-time endpoint.
GOOGLE_DISTANCE_URL=
# Optional paid Google street imagery endpoint.
GOOGLE_STREETVIEW_URL=
# Optional paid Google Places endpoint.
GOOGLE_PLACES_URL=
# Optional paid Google map tiles endpoint.
GOOGLE_MAP_TILES_URL=
# Google credential; paid calls require explicit config enablement.
GOOGLE_MAPS_API_KEY=
# Optional paid Regrid endpoint.
REGRID_URL=
# Optional paid Regrid credential.
REGRID_TOKEN=
# Optional paid Mapbox style endpoint.
MAPBOX_STYLE_URL=
# Optional paid Mapbox credential.
MAPBOX_TOKEN=
# Optional local dashboard port; default is 3000.
PORT=
# Optional Vercel deployment credential for explicitly authorized deployment.
VERCEL_TOKEN=
