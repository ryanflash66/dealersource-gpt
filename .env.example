# SUPABASE_URL: Hosted Supabase project URL.
SUPABASE_URL=
# SUPABASE_ANON_KEY: Read-only dashboard key protected by RLS.
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Pipeline database writer key.
SUPABASE_SERVICE_ROLE_KEY=
# GMAIL_CLIENT_ID: Gmail OAuth application client ID.
GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET: Gmail OAuth application secret.
GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN: Authorized sender mailbox refresh token.
GMAIL_REFRESH_TOKEN=
# REDDIT_CLIENT_ID: Reddit OAuth application client ID.
REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET: Reddit OAuth application secret.
REDDIT_CLIENT_SECRET=
# ANYCRAWL_URL: Self-hosted AnyCrawl endpoint.
ANYCRAWL_URL=
# ORS_API_KEY: OpenRouteService API key for live drive-time requests.
ORS_API_KEY=
# NOMINATIM_URL: Self-hosted Nominatim base URL; never point at the public service.
NOMINATIM_URL=
# OVERPASS_URL: Self-hosted or approved Overpass endpoint.
OVERPASS_URL=
# MAPILLARY_TOKEN: Mapillary API access token.
MAPILLARY_TOKEN=
# PMTILES_URL: Self-hosted PMTiles archive URL.
PMTILES_URL=
# MAP_STYLE_URL: Self-hosted MapLibre style URL.
MAP_STYLE_URL=
# GOOGLE_MAPS_API_KEY: Enables selected paid Google geo, places, imagery, or tiles adapters.
GOOGLE_MAPS_API_KEY=
# REGRID_API_KEY: Enables the selected paid Regrid parcel adapter.
REGRID_API_KEY=
# ANYCRAWL_API_KEY: Enables the selected paid AnyCrawl cloud adapter.
ANYCRAWL_API_KEY=
# CLAUDE_API_KEY: Enables the selected paid Claude API adapter.
CLAUDE_API_KEY=
# VERCEL_TOKEN: Non-interactive Vercel deployment token.
VERCEL_TOKEN=
