{
  "name": "dealersource-gpt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/**/*.test.ts",
    "pipeline": "node --experimental-strip-types src/cli.ts",
    "dashboard:build": "node --experimental-strip-types scripts/build-dashboard.ts",
    "dashboard:dev": "node --experimental-strip-types dashboard/server.ts",
    "typecheck": "tsc --noEmit",
    "deploy:vercel": "pnpm dashboard:build && vercel --prod",
    "verify": "npm test && npm run dashboard:build"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
